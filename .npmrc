# Forzar versión de node/pnpm declarada en engines (agregado por SvelteKit)
engine-strict=true

# Bloquea ejecución de scripts de dependencias (defensa contra supply chain attacks)
ignore-scripts=true

# Fuerza versiones exactas al instalar nuevos paquetes
save-exact=true

# Bloquea instalación si hay vulnerabilidades altas o críticas
audit-level=high

# Usa el registro oficial de npm (previene mirrors envenenados)
registry=https://registry.npmjs.org/
